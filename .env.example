APP_NAME=semantic-scraper
APP_ENV=development
LOG_LEVEL=INFO

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Gemini (Varsayılan) ──────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=gemini_api_anahtarin_buraya
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
# Gemini 1.5/2.5 modelleri çok geniş context destekler
LLM_MAX_CONTENT_CHARS=500000
LLM_TARGET_CONTENT_CHARS=300000

# ── Groq (Alternatif) ────────────────────────────────────────────────────────
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=senin_groq_api_anahtarin_buraya
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.2
# LLM_MAX_CONTENT_CHARS=38000

SCRAPER_DEFAULT_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true
